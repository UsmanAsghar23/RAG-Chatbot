aws_region          = "us-east-1"
project_name        = "rag-api"
environment         = "prod"
desired_count       = 2
task_cpu            = 512
task_memory         = 1024
image_tag           = "latest"
pinecone_index_name = "rag-index"

# Optional: set to an ACM certificate ARN to enable HTTPS and HTTP->HTTPS redirect.
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/abc-123"

# Provide secrets via environment variables when applying:
# export TF_VAR_openai_api_key="sk-..."
# export TF_VAR_pinecone_api_key="..."
# export TF_VAR_api_key="..."
